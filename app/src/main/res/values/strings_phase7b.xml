    <string name="settings_notif_blocked">Android is blocking notifications for RELYRA.</string>
    <string name="settings_notif_open_system">Open Android notification settings</string>
    <string name="settings_notif_preview">Show message text in notifications</string>
    <string name="settings_notif_preview_desc">Off: a notification only says who wrote. On: the text can be read on the lock screen by anyone holding the phone.</string>
    <string name="settings_keep">Stay connected in the background</string>
    <string name="settings_keep_desc">Keeps a permanent notification and the relay connections alive so messages arrive while the app is closed. Uses more battery. Without it, messages are collected when you open the app and periodically by Android.</string>
    <string name="settings_battery">Battery optimization</string>
    <string name="settings_battery_desc">Choose “Don’t optimize” for RELYRA so Android does not stop it in the background.</string>
    <string name="settings_privacy">Privacy</string>
    <string name="settings_shots">Block screenshots</string>
    <string name="settings_shots_desc">Hides RELYRA from screenshots, screen recording and the recent-apps preview.</string>
