    <!-- getting started -->
    <string name="start_title">Get started</string>
    <string name="start_body">RELYRA has no central server. These steps are what it needs to work. Each one reflects the real state of this device.</string>
    <string name="start_relay">Connect to a relay</string>
    <string name="start_relay_desc">A relay carries your encrypted messages between devices. Add one you trust.</string>
    <string name="start_open_network">Open Network</string>
    <string name="start_contact">Add a contact</string>
    <string name="start_contact_desc">Scan a contact’s QR code or open their link. Both of you must add each other.</string>
    <string name="start_notif">Allow notifications</string>
    <string name="start_notif_desc">So you hear about new messages. They show only the sender unless you allow previews.</string>
    <string name="start_allow">Allow</string>
    <string name="home_relays_connected">Relays connected now</string>
    <string name="home_keep">Stay connected</string>
    <string name="net_suggested_title">Suggested public servers</string>
    <string name="net_suggested_body">Run by third parties, not by RELYRA. They never see message contents or file contents (both are encrypted on your device), but they can see that your device connects and when. Tap Test after adding to check that they respond; availability cannot be guaranteed.</string>
    <string name="net_suggested_add">Add</string>

