# HTTPS endpoint used by Android clients.
DISCOVERY_DOMAIN=discovery.example.org
ACME_EMAIL=ops@example.org

# Public TURN endpoint. TURN_EXTERNAL_IP must be the routable public IPv4.
TURN_PUBLIC_HOST=turn.example.org
TURN_REALM=turn.example.org
TURN_EXTERNAL_IP=203.0.113.10
TURN_INTERNAL_IP=172.30.0.11
RELYRA_DOCKER_SUBNET=172.30.0.0/24

# Generate a unique random secret of at least 32 characters:
# openssl rand -hex 32
TURN_SHARED_SECRET=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS

# Empty only for the first public bootstrap node. Other DHT nodes must use
# comma-separated /ip4/<ip>/tcp/4001/p2p/<peer-id> addresses.
RELYRA_BOOTSTRAP_PEERS=

# The public multiaddress of THIS node, including its persisted Peer ID.
# After first startup, read peerId from /healthz and set this value.
RELYRA_ANNOUNCE_MULTIADDRS=


# Store-and-Forward is opt-in for each relay operator. Stored payloads are opaque E2EE packets.
RELYRA_STORE_FORWARD_ENABLED=false
